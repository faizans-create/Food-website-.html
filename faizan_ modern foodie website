<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Foodie Fleet — Full E-commerce Demo (Final Correction)</title>
  <meta name="description" content="Fully corrected Foodie Fleet demo with stable sidebar, enhanced cart, payment simulation, and dynamic deals." />
  <link rel="icon" href="data:;base64,iVBV...9w0=" />
  <style>
    /* * --- THEME VARIABLES --- */
    :root{
      --bg: #f7fbff;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --accent: #0ea5e9; /* blue */
      --accent-600: #0284c7;
      --success: #16a34a;
      --danger:#ef4444;
      --glass: rgba(255,255,255,0.6);
      --transition: 240ms cubic-bezier(.2,.9,.3,1);
    }
    [data-theme="dark"]{
      --bg: #0b1220;
      --card: #071026;
      --text: #e6f0ff;
      --muted: #98a8bf;
      --accent: #60a5fa;
      --accent-600: #3b82f6;
      --glass: rgba(255,255,255,0.04);
    }

    /* * --- CORE STYLES --- */
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial; background:var(--bg); color:var(--text); transition:background var(--transition), color var(--transition)}

    .app{min-height:100vh;display:flex}
    .sidebar{
      width:260px;
      flex:0 0 260px;
      background:linear-gradient(180deg,var(--card),var(--glass));
      border-right:1px solid rgba(0,0,0,0.04);
      padding:18px;
      transform:translateX(-100%);
      transition:transform var(--transition);
      position:fixed;
      left:0;
      top:0;
      bottom:0;
      z-index:40;
    }
    .sidebar.open{transform:translateX(0)}
    .sidebar h2{margin:0 0 12px;font-size:20px}
    .nav-item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:8px;color:var(--text);text-decoration:none;margin-bottom:6px}
    .nav-item:hover{background:rgba(0,0,0,0.04)}

    .main{flex:1;padding:24px;margin-left:0;transition:margin-left var(--transition)}
    
    @media (min-width: 801px) { 
        .sidebar.open {
            transform: translateX(0);
        }
        .main.shift {
            margin-left: 260px; 
        }
    }
    
    .topbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .hambtn{background:transparent;border:1px solid rgba(0,0,0,0.06);padding:8px;border-radius:8px;cursor:pointer}
    .brand{display:flex;align-items:center;gap:10px}
    .brand .logo{width:36px;height:36px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;font-weight:700}

    .card{background:var(--card);padding:18px;border-radius:12px;box-shadow:0 6px 18px rgba(2,6,23,0.06);border:1px solid rgba(2,6,23,0.04)}

    .auth-wrap{max-width:420px;margin:36px auto}
    .auth-card{padding:28px;border-radius:12px}
    .field input{padding:10px 12px;border:1px solid rgba(2,6,23,0.08);border-radius:8px;background:transparent;color:var(--text)}
    .muted{color:var(--muted);font-size:13px}
    .btn{background:var(--accent);color:white;padding:10px 14px;border-radius:10px;border:none;cursor:pointer}
    .btn.ghost{background:transparent;border:1px solid rgba(2,6,23,0.06);color:var(--text)}

    .hidden{display:none}

    .whatsapp{position:fixed;right:18px;bottom:18px;background:#25D366;color:white;padding:12px;border-radius:999px;display:flex;align-items:center;gap:8px;box-shadow:0 12px 30px rgba(37,211,102,0.14);cursor:pointer;border:4px solid rgba(255,255,255,0.06); z-index: 30;}

    @media (max-width:800px){
      .main.shift{margin-left:0}
    }

    .dashboard-view { 
        min-height: 40vh;
        padding: 20px;
        margin-top: 18px;
        border-radius: 12px;
        background: var(--card);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    #view-dashboard .dashboard-view:not(.active) { display: none; }
    
    .modal{
        position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
        background: rgba(0,0,0,0.5); z-index: 50; display: none;
        justify-content: center; align-items: center;
        opacity: 0; transition: opacity 0.3s;
    }
    .modal.show{display:flex; opacity: 1;}
    .modal-content{
        background: var(--card); border-radius: 12px; padding: 20px;
        width: 90%; max-width: 500px;
        transform: translateY(-50px); transition: transform 0.3s;
    }
    .modal.show .modal-content{transform: translateY(0);}

    .deal-card {
        background: linear-gradient(135deg, var(--card), var(--bg)); 
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 15px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .deal-card h4 { color: var(--accent-600); margin-bottom: 5px; }
    .deal-card .price { font-weight: bold; font-size: 1.1em; }

  </style>
</head>
<body>
  <div class="app" id="app" data-theme="light">

    <aside class="sidebar" id="sidebar" aria-hidden="true">
      <h2>Foodie Fleet</h2>
      <p class="muted">Delivering happy tummies 🍕</p>
      <nav style="margin-top:14px">
        <a href="#" class="nav-item view-link" data-view="home">🏠 Home</a>
        <a href="#" class="nav-item view-link" data-view="orders">📦 Orders</a>
        <a href="#" class="nav-item view-link" data-view="profile">👤 Profile</a>
        <a href="#" class="nav-item view-link" data-view="settings">⚙️ Settings</a>
      </nav>
      <div style="margin-top:18px">
        <button class="btn" id="logoutBtn">Logout</button>
      </div>
      <div style="position:absolute;left:18px;bottom:18px;right:18px">
        <hr style="border:none;border-top:1px solid rgba(0,0,0,0.04)" />
        <div class="muted" style="margin-top:10px">Theme</div>
        <div style="display:flex;gap:8px;margin-top:8px">
          <button class="btn ghost" id="themeLight">Light</button>
          <button class="btn" id="themeDark">Dark</button>
        </div>
      </div>
    </aside>

    <main class="main" id="main">
      <div class="topbar">
        <div class="brand">
          <button class="hambtn" id="toggleSidebar" aria-label="Open menu">☰</button>
          <div class="logo avatar">FF</div>
          <div>
            <div class="brand-text">Foodie Fleet</div>
            <div class="muted">Your food delivery partner</div>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:12px">
          <div class="muted">Theme</div>
          <label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" id="themeToggle" />
            <span class="muted">Dark</span>
          </label>
        </div>
      </div>

      <section id="view-auth" class="auth-wrap">
        <div class="card auth-card" id="authCard">
          <div id="loginView">
            <h1>Welcome back</h1>
            <p class="muted">Login to continue to Foodie Fleet</p>
            <div class="field"><label class="muted">Email</label><input id="loginEmail" type="email" placeholder="you@example.com" /></div>
            <div class="field"><label class="muted">Password</label><input id="loginPassword" type="password" placeholder="password" /></div>
            <div class="row">
              <button class="btn" id="loginBtn">Login</button>
              <button class="btn ghost right" id="showSignupBtn">Create account</button>
            </div>
          </div>

          <div id="signupView" class="hidden">
            <h1>Create account</h1>
            <p class="muted">Quick signup. We keep it local for demo.</p>
            <div class="field"><label class="muted">Full name</label><input id="signupName" type="text" placeholder="Your name" /></div>
            <div class="field"><label class="muted">Email</label><input id="signupEmail" type="email" placeholder="you@example.com" /></div>
            <div class="field"><label class="muted">Password</label><input id="signupPassword" type="password" placeholder="strong password" /></div>
            <div class="row">
              <button class="btn" id="signupBtn">Sign up</button>
              <button class="btn ghost right" id="showLoginBtn">Back to login</button>
            </div>
          </div>
        </div>
      </section>

      <section id="view-dashboard" class="hidden">
        <div style="max-width:1000px;margin:28px auto">
          
          <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px">
            <div style="display:flex;gap:12px;align-items:center">
              <div class="avatar" id="dashAvatar">U</div>
              <div>
                <div id="dashWelcome" style="font-weight:700">Hey, User</div>
                <div class="muted" id="dashEmail">you@example.com</div>
              </div>
            </div>
            <div style="display:flex;gap:10px;align-items:center">
              <button class="btn ghost" id="openWhats">Contact (WhatsApp)</button>
              <button class="btn" id="openCart">Cart (<span id="cartCountHeader">0</span>)</button>
            </div>
          </div>

          <div id="home-view" class="dashboard-view active">
             <h3>🏠 Welcome Home!</h3>
             <p class="muted">Explore our daily deals and featured restaurants.</p>
             
             <div class="card" style="margin-top: 20px;">
                 <h4 style="color: var(--danger); margin-bottom: 10px;">🏏 Cricket Night Specials</h4>
                 <div id="cricket-deals-container"></div>
             </div>
             
             <div class="card" style="margin-top: 20px;">
                 <h4 style="color: var(--accent-600); margin-bottom: 10px;">❄️ Warm Winter Favorites</h4>
                 <div id="winter-deals-container"></div>
             </div>

             <hr style="margin:20px 0;border:none;border-top:1px solid rgba(0,0,0,0.04)" />
             
             <h4>Featured Restaurants</h4>
             <div id="restaurant-list-container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px; margin-top: 15px;">
                </div>
          </div>
          
          <div id="orders-view" class="dashboard-view">
             <h3>📦 Your Orders</h3>
             <p class="muted">View your order history and track recent deliveries.</p>
             <div class="card" style="margin-top: 15px;">No active orders.</div>
          </div>
          
          <div id="profile-view" class="dashboard-view">
             <h3>👤 Profile Settings</h3>
             <p class="muted">Update your personal details.</p>
             <div class="card" style="margin-top: 15px;">Name: <span id="profileName"></span> | Email: <span id="profileEmail"></span></div>
          </div>
          
          <div id="settings-view" class="dashboard-view">
             <h3>⚙️ Application Settings</h3>
             <p class="muted">Manage preferences and theme.</p>
             <div class="card" style="margin-top: 15px;">Theme is currently: <span id="currentTheme">Light</span></div>
          </div>


          <footer>© 2025 Foodie Fleet — demo. Theme saved in localStorage.</footer>
        </div>
      </section>

    </main>

    <div class="whatsapp" id="whatsappBtn" title="Message us on WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 11.5a8.38 8.38 0 0 1-1.5 4.9L21 21l-4.6-1.6A8.38 8.38 0 1 1 21 11.5z" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M16 11a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v2" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span style="font-weight:700">Chat</span>
    </div>
    
    <div id="cartModal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
                <h3 style="margin:0;">🛒 Shopping Cart</h3>
                <button class="btn ghost" onclick="document.getElementById('cartModal').classList.remove('show')">X</button>
            </div>
            
            <div id="cart-items-list" style="max-height: 300px; overflow-y: auto; margin-bottom: 15px;">
                <p class="muted" id="cart-empty-message">Your cart is empty.</p>
            </div>
            
            <div style="border-top: 1px solid #eee; padding-top: 10px;">
                <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 1.1em; margin-bottom: 10px;">
                    <span>Total:</span>
                    <span id="cart-total-price">Rs. 0</span>
                </div>
                <button class="btn" style="background: var(--success);" id="checkoutBtn" disabled>Proceed to Payment</button>
            </div>
        </div>
    </div>
    
     <div id="paymentModal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
                <h3 style="margin:0;">💳 Payment Options</h3>
                <button class="btn ghost" onclick="document.getElementById('paymentModal').classList.remove('show')">X</button>
            </div>
            
            <p>Total amount due: <span id="payment-amount" style="font-weight: bold;">Rs. 0</span></p>
            
            <div style="margin-top: 15px;">
                <label style="display: block; margin-bottom: 10px;"><input type="radio" name="payment_method" value="card" checked> Credit/Debit Card (Simulated)</label>
                <label style="display: block; margin-bottom: 10px;"><input type="radio" name="payment_method" value="cash"> Cash on Delivery (CoD)</label>
            </div>
            
            <button class="btn" style="background: var(--success); margin-top: 20px;" id="confirmPaymentBtn">Confirm Order & Pay</button>
        </div>
    </div>


  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => { // **CRITICAL FIX: Ensure all elements are loaded before running JS**

      // --- CONFIG & STATE ---
      const KEY_USER = 'ff_user';
      const KEY_THEME = 'ff_theme';
      let cart = {}; 
      const WHATSAPP_PHONE = '+923001234567';

      // --- RESTAURANT DATA & DEALS ---
      const restaurantData = {
          featured: [
              { id: 'pizzamax', name: 'Pizza Max', desc: 'Italian · Pizza', price: 950, img: 'https://images.unsplash.com/photo-1541745537418-554045e45a0e?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'burgerlab', name: 'Burger Lab', desc: 'Fast Food', price: 750, img: 'https://images.unsplash.com/photo-1551782450-a2132b4ba21d?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'kolachi', name: 'Kolachi', desc: 'Pakistani · Seafood', price: 1200, img: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'ginsoy', name: 'Ginsoy', desc: 'Chinese · Asian', price: 890, img: 'https://images.unsplash.com/photo-1576402187878-974f70c890a5?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'hotspot', name: 'Hot Spot Cafe', desc: 'Desserts · Ice Cream', price: 500, img: 'https://images.unsplash.com/photo-1567197786959-a29a393521d4?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'kfc', name: 'KFC', desc: 'Fast Food · Fried Chicken', price: 650, img: 'https://images.unsplash.com/photo-1588315024225-88f9104f7f63?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'bundoo', name: 'Bundoo Khan', desc: 'BBQ · Paratha Rolls', price: 400, img: 'https://images.unsplash.com/photo-1616252980327-ec70572e5df9?crop=entropy&fit=crop&h=150&q=80&w=220' },
              { id: 'scream', name: 'Scream', desc: 'Premium Ice Cream', price: 700, img: 'https://images.unsplash.com/photo-1622941367239-8acd68fa946d?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8Y3JlYW15JTIwcGFzdHJyeXxlbnwwfHwwfHx8MA%3D%3D' },
          ],
          cricketDeals: [
              { id: 'sixer', name: 'Sixer Pizza Deal', price: 1999, original: 2400 },
              { id: 'wicket', name: 'Wicket Burger Combo', price: 1499, original: 1800 },
          ],
          winterDeals: [
              { id: 'cornsoup', name: 'Corn Soup Family Pack', price: 550, original: 700 },
              { id: 'hotcoco', name: 'Hot Chocolate Duo', price: 350, original: 450 },
          ]
      };

      // --- ELEMENTS ---
      const main = document.getElementById('main');
      const viewAuth = document.getElementById('view-auth');
      const viewDashboard = document.getElementById('view-dashboard');
      const loginEmail = document.getElementById('loginEmail');
      const loginPassword = document.getElementById('loginPassword');
      const sidebar = document.getElementById('sidebar');
      const toggleSidebar = document.getElementById('toggleSidebar');
      const cartModal = document.getElementById('cartModal');
      const paymentModal = document.getElementById('paymentModal');
      const cartCountHeader = document.getElementById('cartCountHeader');
      const cartItemsList = document.getElementById('cart-items-list');
      const cartTotal = document.getElementById('cart-total-price');
      const checkoutBtn = document.getElementById('checkoutBtn');
      const confirmPaymentBtn = document.getElementById('confirmPaymentBtn');
      const paymentAmount = document.getElementById('payment-amount');
      const restaurantListContainer = document.getElementById('restaurant-list-container');
      const cricketDealsContainer = document.getElementById('cricket-deals-container');
      const winterDealsContainer = document.getElementById('winter-deals-container');
      const currentTheme = document.getElementById('currentTheme');
      const dashWelcome = document.getElementById('dashWelcome');
      const dashEmail = document.getElementById('dashEmail');
      const dashAvatar = document.getElementById('dashAvatar');
      const profileName = document.getElementById('profileName');
      const profileEmail = document.getElementById('profileEmail');

      // --- HELPERS ---
      const save = (k,v) => localStorage.setItem(k, JSON.stringify(v));
      const load = (k) => { try{ return JSON.parse(localStorage.getItem(k)); }catch(e){ return null; }};

      // --- MODAL FUNCTIONS ---
      function openModal(modalId) {
          document.getElementById(modalId).classList.add('show');
      }
      // Use document.addEventListener('click') for general modal closing outside the content
      document.addEventListener('click', (e) => {
          if (e.target.classList.contains('modal')) {
              e.target.classList.remove('show');
          }
      });
      document.getElementById('openCart').addEventListener('click', () => openModal('cartModal'));


      // --- RENDER LOGIC: DEALS & RESTAURANTS ---
      function renderDeals(container, deals, isDeal = true) {
          let html = '';
          deals.forEach(item => {
              const originalPrice = isDeal ? `<s class="muted" style="margin-left: 10px;">Rs. ${item.original}</s>` : '';
              html += `
                  <div class="deal-card">
                      <div>
                          <h4>${item.name}</h4>
                          <span class="price">Rs. ${item.price}</span>${originalPrice}
                      </div>
                      <button class="btn add-to-cart" data-id="${item.id}" data-name="${item.name}" data-price="${item.price}" style="background: var(--success); padding: 8px 12px;">Add</button>
                  </div>
              `;
          });
          container.innerHTML = html;
      }
      
      function renderRestaurantList() {
          let html = '';
          restaurantData.featured.forEach(item => {
              html += `
                  <div class="card" style="padding: 0; overflow: hidden; cursor: pointer;">
                      <img src="${item.img}" alt="${item.name}" style="width: 100%; height: 100px; object-fit: cover;">
                      <div style="padding: 18px; display: flex; justify-content: space-between; align-items: center;">
                          <div>
                            <div style="font-weight: 600;">${item.name}</div>
                            <small class="muted">${item.desc} | Rs. ${item.price}</small>
                          </div>
                          <button class="btn add-to-cart" data-id="${item.id}" data-name="${item.name}" data-price="${item.price}" style="background: var(--success); padding: 6px 10px;">+</button>
                      </div>
                  </div>
              `;
          });
          restaurantListContainer.innerHTML = html;
      }

      // --- CART FUNCTIONALITY ---

      function calculateCartTotal() {
          let total = 0;
          let count = 0;
          for (const id in cart) {
              total += cart[id].price * cart[id].qty;
              count += cart[id].qty;
          }
          return { total, count };
      }

      function updateCartUI() {
          const { total, count } = calculateCartTotal();
          cartCountHeader.textContent = count;
          cartTotal.textContent = `Rs. ${total}`;
          paymentAmount.textContent = `Rs. ${total}`; 

          if (count === 0) {
              cartItemsList.innerHTML = '<p class="muted" id="cart-empty-message">Your cart is empty.</p>';
              checkoutBtn.disabled = true;
          } else {
              checkoutBtn.disabled = false;
              let html = '';
              for (const id in cart) {
                  const item = cart[id];
                  html += `
                      <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #eee;">
                          <div style="flex: 1;">
                              <div style="font-weight: bold;">${item.name}</div>
                              <small class="muted">Rs. ${item.price} x ${item.qty}</small>
                          </div>
                          <div style="font-weight: bold; margin-right: 15px;">Rs. ${item.price * item.qty}</div>
                          <div style="display: flex; gap: 5px;">
                              <button class="btn cart-qty-adjust" data-id="${id}" data-action="decrease" style="padding: 5px 8px; background: var(--danger);">-</button>
                              <button class="btn cart-qty-adjust" data-id="${id}" data-action="increase" style="padding: 5px 8px;">+</button>
                          </div>
                      </div>
                  `;
              }
              cartItemsList.innerHTML = html;
          }
      }
      
      function addToCart(id, name, price) {
          const numericPrice = parseFloat(price);
          if (cart[id]) {
              cart[id].qty += 1;
          } else {
              cart[id] = { id, name, price: numericPrice, qty: 1 };
          }
          updateCartUI();
      }

      function handleCartQuantity(id, action) {
          if (!cart[id]) return;

          if (action === 'increase') {
              cart[id].qty += 1;
          } else if (action === 'decrease') {
              cart[id].qty -= 1;
              if (cart[id].qty <= 0) {
                  delete cart[id]; 
              }
          }
          updateCartUI();
      }

      // Event listener for adding items and adjusting quantity (delegated)
      document.addEventListener('click', (e) => {
          if (e.target.classList.contains('add-to-cart')) {
              if (viewDashboard.classList.contains('hidden')) {
                  alert('Please log in to add items to your cart.');
                  return;
              }
              const { id, name, price } = e.target.dataset;
              addToCart(id, name, price);
          }
          if (e.target.classList.contains('cart-qty-adjust')) {
              const { id, action } = e.target.dataset;
              handleCartQuantity(id, action);
          }
      });
      
      // --- PAYMENT OPTION & CHECKOUT SIMULATION ---
      
      checkoutBtn.addEventListener('click', () => {
          cartModal.classList.remove('show');
          openModal('paymentModal');
      });
      
      confirmPaymentBtn.addEventListener('click', () => {
          const { total } = calculateCartTotal();
          if (total === 0) return;
          
          const method = document.querySelector('input[name="payment_method"]:checked').value;
          
          alert(`Order Placed! Total: Rs. ${total}. Payment Method: ${method === 'cash' ? 'Cash on Delivery (CoD)' : 'Card (Processed)'}. Thank you for ordering from Foodie Fleet!`);
          
          cart = {};
          updateCartUI();
          paymentModal.classList.remove('show');
      });


      // --- AUTH, THEME, NAVIGATION LOGIC ---
      
      const initTheme = () =>{
        const saved = load(KEY_THEME) || 'light';
        setTheme(saved);
      };

      function setTheme(name){
        document.getElementById('app').setAttribute('data-theme', name);
        save(KEY_THEME, name);
        if (currentTheme) currentTheme.textContent = name.charAt(0).toUpperCase() + name.slice(1);
      }
      
      function showLogin(){ 
          document.getElementById('signupView').classList.add('hidden'); 
          document.getElementById('loginView').classList.remove('hidden'); 
      }
      function showSignup(){ 
          document.getElementById('loginView').classList.add('hidden'); 
          document.getElementById('signupView').classList.remove('hidden'); 
      }
      document.getElementById('showSignupBtn').addEventListener('click', showSignup);
      document.getElementById('showLoginBtn').addEventListener('click', showLogin);
      
      function showView(viewId) {
          document.querySelectorAll('.dashboard-view').forEach(view => {
              view.classList.remove('active');
          });
          const requestedView = document.getElementById(viewId + '-view');
          if (requestedView) {
              requestedView.classList.add('active');
          }
      }

      function afterLogin(user){
        viewAuth.classList.add('hidden');
        viewDashboard.classList.remove('hidden');
        dashWelcome.textContent = `Hey, ${user.name.split(' ')[0]}`;
        dashEmail.textContent = user.email;
        dashAvatar.textContent = (user.name[0] || 'U').toUpperCase();
        profileName.textContent = user.name;
        profileEmail.textContent = user.email;

        renderDeals(cricketDealsContainer, restaurantData.cricketDeals);
        renderDeals(winterDealsContainer, restaurantData.winterDeals);
        renderRestaurantList();
        updateCartUI();

        sidebar.classList.remove('open');
        main.classList.remove('shift');
        if (window.innerWidth > 800) {
            main.classList.add('shift'); 
            sidebar.classList.add('open'); 
        }
        showView('home');
      }

      // --- EVENT LISTENERS ---
      document.getElementById('logoutBtn').addEventListener('click', ()=>{
        localStorage.removeItem(KEY_USER);
        viewDashboard.classList.add('hidden');
        viewAuth.classList.remove('hidden');
        alert('Logged out');
      });
      
      document.getElementById('toggleSidebar').addEventListener('click', ()=>{
        sidebar.classList.toggle('open');
        main.classList.toggle('shift', sidebar.classList.contains('open'));
      });

      document.getElementById('signupBtn').addEventListener('click', ()=>{
        const name = document.getElementById('signupName').value.trim();
        const email = document.getElementById('signupEmail').value.trim().toLowerCase();
        const pass = document.getElementById('signupPassword').value;
        if(!name || !email || !pass){ alert('Please fill all signup fields'); return; }
        if(!/\S+@\S+\.\S+/.test(email)){ alert('Enter a valid email'); return; }
        const existing = load(KEY_USER);
        if(existing && existing.email === email){ alert('User already exists. Please login.'); showLogin(); return; }
        const user = { name, email, password: pass };
        save(KEY_USER, user);
        alert('Signup successful — you are now logged in (demo)');
        afterLogin(user);
      });

      document.getElementById('loginBtn').addEventListener('click', ()=>{
        const email = loginEmail.value.trim().toLowerCase();
        const pass = loginPassword.value;
        if(!email || !pass){ alert('Please fill login fields'); return; }
        const existing = load(KEY_USER);
        if(!existing){ alert('No user found. Please sign up first.'); showSignup(); return; }
        if(existing.email !== email || existing.password !== pass){ alert('Invalid credentials'); return; }
        alert('Login successful');
        afterLogin(existing);
      });
      
      document.querySelectorAll('.view-link').forEach(link => {
          link.addEventListener('click', (e) => {
              e.preventDefault();
              showView(link.getAttribute('data-view'));
              if (window.innerWidth <= 800) {
                sidebar.classList.remove('open');
                main.classList.remove('shift');
            }
          });
      });
      
      // UX: close sidebar on outside click for small screens
      document.addEventListener('click', (e)=>{
        if(window.innerWidth <= 800 && sidebar.classList.contains('open')){
          const inside = sidebar.contains(e.target) || toggleSidebar.contains(e.target);
          if(!inside && !e.target.classList.contains('modal')) {
            sidebar.classList.remove('open');
            main.classList.remove('shift');
          }
        }
      });
      
      // WhatsApp open
      document.getElementById('whatsappBtn').addEventListener('click', ()=> openWhatsApp(WHATSAPP_PHONE));
      document.getElementById('openWhats').addEventListener('click', ()=> openWhatsApp(WHATSAPP_PHONE));
      function openWhatsApp(phone){
        const msg = encodeURIComponent("Hi Foodie Fleet! I need help with my order.");
        const url = `https://wa.me/${phone.replace(/[^0-9+]/g,'')}?text=${msg}`;
        window.open(url, '_blank');
      }

      // --- INITIALIZATION ---
      initTheme();
      const existing = load(KEY_USER);
      if(existing){ afterLogin(existing); }

    });
  </script>
</body>
</html>
